{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/*/test/**/*.ts",
    "apps/*/test/**/*.ts"
  ],
  // The web app's tests are checked with its own (bundler) settings: pnpm --filter @factory/web typecheck.
  "exclude": [
    "apps/web/test/**"
  ]
}
