# Local development. Copy to .env and fill in; `pnpm dev:harness` / `pnpm dev:runner` load it.
# On Railway these come from shared variables (see .railway/railway.ts and docs/setup.md).

DATABASE_URL=postgres://postgres:postgres@localhost:5432/factory

# GitHub App (Settings -> Developer settings -> GitHub Apps). Optional: leave these
# empty and the /setup page creates the App from a manifest and stores it in the database.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM contents; literal \n sequences are accepted
GITHUB_APP_PRIVATE_KEY=

# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Comma-separated GitHub logins allowed to sign in, or * for any GitHub account
ALLOWED_GITHUB_LOGINS=shixzie
# The origin users see: the web app, which forwards /api and /auth to the harness.
# The harness uses it for OAuth redirects, cookies and the Origin check.
PUBLIC_URL=http://localhost:3000
# Locally the harness listens on 3001 and the web app (pnpm dev:web) on 3000
PORT=3001
# Web app: where it reaches the harness
HARNESS_INTERNAL_URL=http://localhost:3001

# Runner: Railway project token for the environment sandboxes run in, and that environment's id.
# Optional: leave empty and the /setup page creates them (only when running on Railway).
RAILWAY_SANDBOX_TOKEN=
SANDBOX_ENVIRONMENT_ID=
HARNESS_URL=http://localhost:3000
# Model API keys are not configured here: each user saves their own under Settings (bring your own key).

# Optional tuning
# MAX_CONCURRENT_RUNS=3
# SANDBOX_CHECKPOINT=agent-base
# SANDBOX_REGION=us-west2
# SANDBOX_IDLE_TIMEOUT_MINUTES=15
# Extra runner env vars to copy into every sandbox (not for model keys)
# AGENT_ENV_PASSTHROUGH=
# AGENT_SETUP_COMMAND=command -v claude >/dev/null 2>&1 || npm install -g @anthropic-ai/claude-code
# The default streams Claude Code's JSON so the run page shows each step, and gives it the
# ask-the-user tool and inbox hook (FACTORY_MCP_CONFIG, FACTORY_SETTINGS_FILE, FACTORY_SYSTEM_PROMPT_FILE).
# AGENT_COMMAND=claude -p "$(cat "$FACTORY_TASK_FILE")" --dangerously-skip-permissions --output-format stream-json --verbose --mcp-config "$FACTORY_MCP_CONFIG" --settings "$FACTORY_SETTINGS_FILE" --append-system-prompt "$(cat "$FACTORY_SYSTEM_PROMPT_FILE")"
# AGENT_TIMEOUT_SECONDS=3600

# Previews of servers running in sandboxes (docs/architecture.md, "Previews"); unset leaves them off.
# PREVIEW_SIGNING_KEY=          # openssl rand -base64 48; the same value for harness, runner and gateway
# PREVIEW_DOMAIN=preview.localhost:8090
# PREVIEW_TUNNEL_URL=wss://tunnel.preview.example.com/connect   # runner only; must be reachable from sandboxes
