# Local development. Copy to .env and fill in; `pnpm dev:harness` / `pnpm dev:runner` load it.
# On Railway these come from shared variables (see .railway/railway.ts and docs/setup.md).

DATABASE_URL=postgres://postgres:postgres@localhost:5432/factory

# GitHub App (Settings -> Developer settings -> GitHub Apps)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# PEM contents; literal \n sequences are accepted
GITHUB_APP_PRIVATE_KEY=

# openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Comma-separated GitHub logins allowed to sign in, or * for any GitHub account
ALLOWED_GITHUB_LOGINS=shixzie
# Harness origin; on Railway it defaults to https://$RAILWAY_PUBLIC_DOMAIN
PUBLIC_URL=http://localhost:3000

# Runner: Railway project token for the environment sandboxes run in, and that environment's id
RAILWAY_SANDBOX_TOKEN=
SANDBOX_ENVIRONMENT_ID=
HARNESS_URL=http://localhost:3000
# Model API keys are not configured here: each user saves their own under Settings (bring your own key).

# Optional tuning
# MAX_CONCURRENT_RUNS=3
# SANDBOX_CHECKPOINT=agent-base
# SANDBOX_REGION=us-west2
# SANDBOX_IDLE_TIMEOUT_MINUTES=15
# Extra runner env vars to copy into every sandbox (not for model keys)
# AGENT_ENV_PASSTHROUGH=
# AGENT_SETUP_COMMAND=command -v claude >/dev/null 2>&1 || npm install -g @anthropic-ai/claude-code
# AGENT_COMMAND=claude -p "$(cat "$FACTORY_TASK_FILE")" --dangerously-skip-permissions
# AGENT_TIMEOUT_SECONDS=3600
